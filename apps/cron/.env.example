PORT=4000
WEB_ORIGIN=http://localhost:3000

# Open Payments client — from a test wallet at https://wallet.interledger-test.dev
# (Settings → Developer keys). Never commit the real values.
OPEN_PAYMENTS_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-wallet
OPEN_PAYMENTS_KEY_ID=
# Path to the private key file downloaded from the test wallet
OPEN_PAYMENTS_PRIVATE_KEY_PATH=./private.key
