{
  "$schema": "merit-design-tokens/v1",
  "brand": {
    "name": "merit",
    "wordmark": { "family": "Outfit", "weight": 700, "letterSpacing": "-0.055em", "case": "lowercase", "dot": { "size": "0.17em", "color": "senal", "shape": "circle", "align": "baseline" } },
    "isotype": { "letter": "m", "radius": "27%", "background": "merito", "dot": "senal" },
    "productSeal": "powered by Open Payments"
  },
  "color": {
    "noche": "#0A0A0F",
    "grafito": "#15151D",
    "linea": "#26262F",
    "lineaFuerte": "#3A3A46",
    "divisor": "#1E1E26",
    "hueso": "#F5F5F7",
    "niebla": "#A1A1AE",
    "deshabilitado": "#8A8A96",
    "merito": "#6E4BFF",
    "lavanda": "#A898FF",
    "senal": "#C6F432",
    "ambar": "#FFB547",
    "coral": "#FF5C7A",
    "papel": "#F6F5F1",
    "white": "#FFFFFF"
  },
  "semantic": {
    "bg": "noche",
    "surface": "grafito",
    "border": "linea",
    "borderControl": "lineaFuerte",
    "text": "hueso",
    "textMuted": "niebla",
    "primary": "merito",
    "onPrimary": "white",
    "link": "lavanda",
    "success": "senal",
    "onSuccess": "noche",
    "warning": "ambar",
    "danger": "coral",
    "focus": "merito"
  },
  "scoreBands": [
    { "id": "bajo", "label": "Bajo", "min": 300, "max": 579, "fg": "#FF8FA3", "bg": "#2A1820" },
    { "id": "regular", "label": "Regular", "min": 580, "max": 669, "fg": "#FFB547", "bg": "#2A2216" },
    { "id": "bueno", "label": "Bueno", "min": 670, "max": 739, "fg": "#C6F432", "bg": "#1F2610" },
    { "id": "excelente", "label": "Excelente", "min": 740, "max": 850, "fg": "#A898FF", "bg": "#1E1A33" }
  ],
  "font": {
    "display": "'Outfit', sans-serif",
    "body": "'DM Sans', sans-serif",
    "mono": "'JetBrains Mono', monospace",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
  },
  "type": {
    "display": { "family": "display", "weight": 600, "size": 56, "lineHeight": 60, "tracking": "-0.03em" },
    "h1": { "family": "display", "weight": 600, "size": 36, "lineHeight": 40, "tracking": "-0.02em" },
    "h2": { "family": "display", "weight": 500, "size": 24, "lineHeight": 30 },
    "body": { "family": "body", "weight": 400, "size": 16, "lineHeight": 24 },
    "data": { "family": "mono", "weight": 500, "size": 22, "numeric": "tabular-nums" },
    "label": { "family": "mono", "weight": 500, "size": 12, "tracking": "0.14em", "transform": "uppercase" }
  },
  "radius": { "control": 14, "card": 24, "cardSm": 18, "chip": 8, "pill": 999 },
  "size": { "touchMin": 44, "buttonPrimary": 52 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64 },
  "contrast": {
    "hueso/noche": "18:1",
    "noche/senal": "15:1",
    "white/merito": "5.1:1",
    "lavanda/noche": "8:1",
    "niebla/noche": "7.7:1",
    "niebla/grafito": "7.1:1"
  }
