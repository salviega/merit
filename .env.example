# Merit — one env file for every app in the monorepo.
# Copy to `.env` (ignored by git) and fill it in. `apps/web` loads it from
# next.config.ts; `apps/cron` and the scripts load it with --env-file.
# Never commit the real values.

# --- Open Payments client (Merit's own wallet on wallet.interledger-test.dev,
#     Settings → Developer keys) ---------------------------------------------
OPEN_PAYMENTS_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-merit-wallet
OPEN_PAYMENTS_KEY_ID=
# The private key PEM, base64-encoded in one line:
#   base64 < private.key | tr -d '\n'
OPEN_PAYMENTS_PRIVATE_KEY=

# --- Public URL of the local app (Cloudflare Tunnel hostname) --------------
# Base of the grant `interact.finish` callbacks and of every link to the app.
APP_URL=https://merit.your-domain.com
# Same hostname, set on Vercel so the landing's buttons point to the app.
# Leave empty locally.
NEXT_PUBLIC_APP_URL=

# --- Cloudflare Tunnel (`pnpm tunnel`) -------------------------------------
# Named tunnel: Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel,
# route a public hostname to http://localhost:3000 and copy the token shown
# for `cloudflared tunnel run --token ...`. Needs a domain on Cloudflare.
# Leave the token empty to get a quick tunnel instead: a random
# trycloudflare.com URL on every start, which you must copy into APP_URL.
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=merit.your-domain.com

# --- Web -------------------------------------------------------------------
# Signs the httpOnly cookie that ties a browser to its score request.
#   openssl rand -hex 32
SESSION_SECRET=

# --- Store -----------------------------------------------------------------
# JSON file shared by apps/web and apps/cron, relative to the repo root.
DATA_FILE=./data/merit.json

# --- Repayment service (apps/cron) ----------------------------------------
CRON_INTERVAL_MS=5000

# --- Test wallets for the demo and `pnpm seed:history` --------------------
# A lends, B borrows, C pays B.
SEED_LENDER_WALLET=https://ilp.interledger-test.dev/wallet-a
SEED_BORROWER_WALLET=https://ilp.interledger-test.dev/wallet-b
SEED_PAYER_WALLET=https://ilp.interledger-test.dev/wallet-c
