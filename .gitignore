# [ADAPTAR] Genérico para varios stacks — borra las secciones que no
# apliquen a tu proyecto y ajusta las que sí. El de Moor terminó siendo más
# específico que esto (rutas de packages/, qué carpeta de Foundry sí se
# versiona para dejar evidencia de despliegue) — vuelve a mirarlo como
# ejemplo real una vez decidas el stack en el 06_tecnologias.md.

# --- Node / JS / TS (npm, pnpm, yarn) ---
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Next.js ---
.next/
out/

# --- Vite / CRA ---
# dist/ ya cubierto arriba

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Foundry / Solidity ---
# [ADAPTAR] Si desplegás en una testnet real y querés dejar evidencia de
# hashes de transacción (como pedía el AGENTS.md de Moor), NO ignores por
# completo broadcast/ — solo la carpeta del chain id local (31337 = Anvil).
cache/
out/
broadcast/*/31337/

# --- Hardhat ---
artifacts/
cache_hardhat/

# --- Env y secretos ---
.env
.env.local
.env*.local
*.pem
*.key

# --- Despliegue ---
.vercel
.netlify

# --- Cobertura y reportes ---
coverage/
.nyc_output/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Claude Code local settings ---
# También excluido globalmente si configuraste ~/.config/git/ignore; se deja
# aquí también para que el repo funcione igual en cualquier máquina.
.claude/settings.local.json

# --- Open Payments test wallet key ---
apps/cron/private.key
